# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Domain URL where this applet is hosted (e.g. https://admscovermobil.com or Cloud Run URL)
APP_URL="http://localhost:3000"

# JWT Authentication secret key for Admin session security
JWT_SECRET="adms_secret_jwt_key_change_in_production_2026"

# Default Store WhatsApp Number (Format: 628xxxxxxxxxx without + or spaces)
WHATSAPP_NUMBER="6281234567890"

# Hostinger / MySQL Database Configuration (Optional - falls back to persistent storage engine)
DATABASE_URL="mysql://username:password@localhost:3306/adms_cover_db"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="adms_cover_db"
DB_USER="root"
DB_PASSWORD="your_database_password"

